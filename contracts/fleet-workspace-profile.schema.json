{
  "$id": "https://one-person-lab.dev/schemas/opl-flow/fleet-workspace-profile.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OPL Fleet workspace profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "profiles"],
  "properties": {
    "$schema": {
      "const": "https://one-person-lab.dev/schemas/opl-flow/fleet-workspace-profile.v1.json"
    },
    "schema": {"const": "opl_fleet_workspace_profiles.v1"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"},
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_ids",
        "workspace_root",
        "environment_contract",
        "repositories",
        "automation_placements"
      ],
      "properties": {
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}
        },
        "workspace_root": {
          "type": "string",
          "pattern": "^~/[A-Za-z0-9._/-]+$"
        },
        "environment_contract": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/repository"}
        },
        "automation_placements": {
          "type": "array",
          "items": {"$ref": "#/$defs/automation"}
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "directory", "branch", "remote", "role", "required"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "directory": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "remote": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+\\.git$"
        },
        "role": {
          "enum": ["authority", "implementation_dependency"]
        },
        "required": {"type": "boolean"}
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "singleton_key", "role", "migration_order", "desired_state"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "singleton_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:.-]{0,127}$"},
        "role": {"enum": ["ledger_supervisor", "github_patrol"]},
        "migration_order": {"type": "integer", "minimum": 1},
        "desired_state": {"enum": ["disabled", "shadow", "active"]}
      }
    }
  }
}
