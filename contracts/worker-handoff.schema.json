{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Carrier-neutral Worker handoff",
  "required": [
    "schema",
    "attempt_id",
    "objective_id",
    "owner_id",
    "scope",
    "expected_result",
    "input_refs",
    "checkpoint_refs"
  ],
  "properties": {
    "schema": {
      "const": "opl_worker_handoff.v1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "objective_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "expected_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000\\r\\n]+$"
      }
    },
    "checkpoint_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000\\r\\n]+$"
      }
    }
  }
}
