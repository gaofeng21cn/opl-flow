{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fleet-telemetry-protocol.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "product_terms",
    "authority",
    "provider_abi",
    "modes",
    "compatibility",
    "telemetry_envelope"
  ],
  "properties": {
    "$schema": { "const": "./fleet-telemetry-protocol.schema.json" },
    "schema": { "const": "opl_fleet_telemetry_protocol.v1" },
    "product_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "node_agent", "telemetry_gateway", "cockpit"],
      "properties": {
        "controller": { "$ref": "#/$defs/productTerm" },
        "node_agent": { "$ref": "#/$defs/productTerm" },
        "telemetry_gateway": { "$ref": "#/$defs/productTerm" },
        "cockpit": { "$ref": "#/$defs/productTerm" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "node_agent", "telemetry_gateway", "cockpit"],
      "properties": {
        "controller": { "$ref": "#/$defs/authorityRole" },
        "node_agent": { "$ref": "#/$defs/authorityRole" },
        "telemetry_gateway": { "$ref": "#/$defs/authorityRole" },
        "cockpit": { "$ref": "#/$defs/authorityRole" }
      }
    },
    "provider_abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_ref",
        "schema",
        "capability_abi",
        "native_carrier",
        "package_role",
        "access",
        "authority",
        "operations",
        "read_refs",
        "projection_status",
        "forbidden_authorities",
        "forbidden_fields",
        "host_boundary"
      ],
      "properties": {
        "schema_ref": { "const": "./fleet-agent-provider.schema.json" },
        "schema": { "const": "opl_fleet_agent_provider.v1" },
        "capability_abi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "opl-fleet-agent.capabilities" },
            "version": { "const": "1.0.0" }
          }
        },
        "native_carrier": { "const": "opl_fleet_agent_process" },
        "package_role": { "const": "capability_provider" },
        "access": { "const": "read_only" },
        "authority": { "const": "observation_only" },
        "operations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["telemetry.read", "doctor.read"] }
        },
        "read_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["telemetry", "doctor"],
          "properties": {
            "telemetry": { "const": "fleet.agent.telemetry.v1#local" },
            "doctor": { "const": "fleet.agent.doctor.v1#current" }
          }
        },
        "projection_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["telemetry", "doctor", "execution_constraints", "execution_receipts"],
          "properties": {
            "telemetry": { "const": "projected" },
            "doctor": { "const": "projected" },
            "execution_constraints": { "const": "not_projected" },
            "execution_receipts": { "const": "deferred" }
          }
        },
        "forbidden_authorities": { "$ref": "#/$defs/nonEmptyStringList" },
        "forbidden_fields": { "$ref": "#/$defs/nonEmptyStringList" },
        "host_boundary": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "data_path", "authority"],
        "properties": {
          "id": { "enum": ["local", "direct", "fleet"] },
          "data_path": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_names", "preserve", "service_identifiers", "rename_gate"],
      "properties": {
        "display_names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_agent", "cockpit"],
          "properties": {
            "node_agent": { "const": "OPL Fleet Agent" },
            "cockpit": { "const": "OPL Fleet Cockpit · Ambient Ops" }
          }
        },
        "preserve": { "$ref": "#/$defs/nonEmptyStringList" },
        "service_identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direct", "gateway"],
          "properties": {
            "direct": { "const": "_opl-fleet-agent._tcp.local" },
            "gateway": { "const": "_ambient-ops._tcp.local" }
          }
        },
        "rename_gate": { "type": "string", "minLength": 1 }
      }
    },
    "telemetry_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "identity_fields",
        "observation_fields",
        "doctor_receipt_fields",
        "forbidden_fields",
        "gateway_behavior",
        "evolution"
      ],
      "properties": {
        "schema": { "const": "opl_fleet_agent_telemetry.v1" },
        "identity_fields": { "$ref": "#/$defs/nonEmptyStringList" },
        "observation_fields": { "$ref": "#/$defs/nonEmptyStringList" },
        "doctor_receipt_fields": { "$ref": "#/$defs/nonEmptyStringList" },
        "forbidden_fields": { "$ref": "#/$defs/nonEmptyStringList" },
        "gateway_behavior": { "$ref": "#/$defs/nonEmptyStringList" },
        "evolution": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    }
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "productTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "implementation"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 }
      }
    },
    "authorityRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owns", "must_not_own"],
      "properties": {
        "owns": { "$ref": "#/$defs/nonEmptyStringList" },
        "must_not_own": { "$ref": "#/$defs/nonEmptyStringList" }
      }
    }
  }
}
