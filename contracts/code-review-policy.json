{
  "$schema": "./code-review-policy.schema.json",
  "schema": "opl_flow_code_review_policy.v1",
  "default_mode": "off",
  "delivery": {
    "baseline_gates": "repository_and_task_owned_unchanged",
    "linear_cloud_coding_sessions": "disabled_by_default",
    "pr_policy": "repository_owned",
    "pr_required_by_flow": false
  },
  "modes": {
    "off": {
      "low_risk": "skip",
      "medium_risk": "skip",
      "high_risk": "skip",
      "review_failure_blocks_delivery": false
    },
    "async-risk": {
      "low_risk": "skip",
      "medium_risk": "async",
      "high_risk": "async",
      "review_failure_blocks_delivery": false
    },
    "required": {
      "low_risk": "blocking",
      "medium_risk": "blocking",
      "high_risk": "blocking",
      "review_failure_blocks_delivery": true
    }
  },
  "review_targets": [
    "diff",
    "commit",
    "pull_request"
  ],
  "blocking_authorities": [
    "explicit_user_requirement",
    "repository_policy",
    "required_mode"
  ]
}
