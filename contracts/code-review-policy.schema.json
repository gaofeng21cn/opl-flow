{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaofeng21cn/opl-flow/contracts/code-review-policy.schema.json",
  "title": "OPL Flow code review policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "default_mode",
    "delivery",
    "modes",
    "review_targets",
    "blocking_authorities"
  ],
  "properties": {
    "$schema": { "const": "./code-review-policy.schema.json" },
    "schema": { "const": "opl_flow_code_review_policy.v1" },
    "default_mode": { "enum": ["off", "async-risk", "required"] },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_gates",
        "linear_cloud_coding_sessions",
        "pr_policy",
        "pr_required_by_flow"
      ],
      "properties": {
        "baseline_gates": { "const": "repository_and_task_owned_unchanged" },
        "linear_cloud_coding_sessions": { "const": "disabled_by_default" },
        "pr_policy": { "const": "repository_owned" },
        "pr_required_by_flow": { "const": false }
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["off", "async-risk", "required"],
      "properties": {
        "off": { "$ref": "#/$defs/mode" },
        "async-risk": { "$ref": "#/$defs/mode" },
        "required": { "$ref": "#/$defs/mode" }
      }
    },
    "review_targets": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["diff", "commit", "pull_request"] }
    },
    "blocking_authorities": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "explicit_user_requirement",
          "repository_policy",
          "required_mode"
        ]
      }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low_risk",
        "medium_risk",
        "high_risk",
        "review_failure_blocks_delivery"
      ],
      "properties": {
        "low_risk": { "enum": ["skip", "async", "blocking"] },
        "medium_risk": { "enum": ["skip", "async", "blocking"] },
        "high_risk": { "enum": ["skip", "async", "blocking"] },
        "review_failure_blocks_delivery": { "type": "boolean" }
      }
    }
  }
}
