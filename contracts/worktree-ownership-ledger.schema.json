{
  "$id": "https://one-person-lab.dev/schemas/opl-flow/worktree-ownership-ledger.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "custody_executor": {
            "minLength": 1,
            "type": "string",
            "description": "Executor holding the local custody obligation, independent of the task Ledger execution owner."
          },
          "integration_overlaps": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "objective_ref": {
                  "minLength": 1,
                  "type": "string"
                },
                "custody_owner": {
                  "minLength": 1,
                  "type": "string"
                },
                "paths": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "custody_thread_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "worktree": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "worktree",
                "custody_thread_id",
                "objective_ref",
                "custody_owner",
                "paths"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "custody_next_action": {
            "minLength": 1,
            "type": "string"
          },
          "repo_root": {
            "minLength": 1,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "custody_transfers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recorded_at",
                "reason",
                "from",
                "to"
              ],
              "properties": {
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "$ref": "#/$defs/custodyTransition"
                },
                "to": {
                  "$ref": "#/$defs/custodyTransition"
                }
              }
            }
          },
          "objective_rebindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recorded_at",
                "reason",
                "actor",
                "from",
                "to"
              ],
              "properties": {
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "actor": {
                  "$ref": "#/$defs/custodyActor"
                },
                "from": {
                  "$ref": "#/$defs/objectiveReferenceTransition"
                },
                "to": {
                  "$ref": "#/$defs/objectiveReferenceTransition"
                }
              }
            }
          },
          "objective_ref": {
            "minLength": 1,
            "type": "string",
            "description": "Opaque task reference; rebinding it does not edit the referenced task."
          },
          "custody_owner": {
            "minLength": 1,
            "type": "string",
            "description": "Responsible for source preservation, integration, and cleanup of this worktree."
          },
          "remote_recovery": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "branch": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "commit": {
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string"
                  },
                  "tree": {
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string"
                  }
                },
                "required": [
                  "branch",
                  "commit",
                  "tree"
                ],
                "type": "object"
              }
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "SAFE_TO_ARCHIVE"
            ]
          },
          "custody_thread_id": {
            "minLength": 1,
            "type": "string"
          },
          "worktree": {
            "minLength": 1,
            "type": "string"
          },
          "write_set": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "canonical_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Source delivery evidence, not task completion."
          },
          "production_data_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Source delivery evidence, not task completion."
          },
          "cleanup_reason": {
            "type": "string",
            "description": "Local source lifecycle evidence, not task execution state."
          },
          "cleanup_status": {
            "type": "string",
            "description": "Local source lifecycle evidence, not task execution state."
          },
          "delivery_status": {
            "type": "string",
            "description": "Local source lifecycle evidence, not task execution state."
          },
          "final_receipt": {
            "description": "Preserved owner-produced source lifecycle evidence."
          }
        },
        "required": [
          "worktree",
          "custody_thread_id",
          "objective_ref",
          "custody_owner",
          "custody_executor",
          "status",
          "custody_next_action",
          "write_set",
          "remote_recovery"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "machine": {
      "minLength": 1,
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema": {
      "const": "opl_flow_worktree_ownership_ledger.v2"
    },
    "authority": {
      "const": "worktree_custody"
    }
  },
  "required": [
    "schema",
    "authority",
    "machine",
    "recorded_at",
    "entries"
  ],
  "$defs": {
    "custodyActor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_thread_id",
        "custody_owner",
        "custody_executor"
      ],
      "properties": {
        "custody_thread_id": {
          "type": "string",
          "minLength": 1
        },
        "custody_owner": {
          "type": "string",
          "minLength": 1
        },
        "custody_executor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "custodyTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custody_thread_id",
        "objective_ref",
        "custody_owner",
        "custody_executor",
        "custody_next_action"
      ],
      "properties": {
        "custody_thread_id": {
          "type": "string",
          "minLength": 1
        },
        "objective_ref": {
          "type": "string",
          "minLength": 1
        },
        "custody_owner": {
          "type": "string",
          "minLength": 1
        },
        "custody_executor": {
          "type": "string",
          "minLength": 1
        },
        "custody_next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objectiveReferenceTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_ref",
        "custody_next_action"
      ],
      "properties": {
        "objective_ref": {
          "type": "string",
          "minLength": 1
        },
        "custody_next_action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "title": "OPL Flow worktree custody ledger",
  "type": "object",
  "description": "Local source custody and recovery obligations. objective_ref references a task; only the task Ledger owns its execution owner and completion."
}
