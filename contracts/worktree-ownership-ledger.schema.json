{
  "$id": "https://one-person-lab.dev/schemas/opl-flow/worktree-ownership-ledger.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "execution_owner": {
            "minLength": 1,
            "type": "string"
          },
          "integration_overlaps": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "objective_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "owner": {
                  "minLength": 1,
                  "type": "string"
                },
                "paths": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "thread_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "worktree": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "worktree",
                "thread_id",
                "objective_id",
                "owner",
                "paths"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "next_action": {
            "minLength": 1,
            "type": "string"
          },
          "repo_root": {
            "minLength": 1,
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          },
          "ownership_transfers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recorded_at", "reason", "from", "to"],
              "properties": {
                "recorded_at": {"type": "string", "format": "date-time"},
                "reason": {"type": "string", "minLength": 1},
                "from": {"$ref": "#/$defs/ownerTransition"},
                "to": {"$ref": "#/$defs/ownerTransition"}
              }
            }
          },
          "objective_amendments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recorded_at", "reason", "actor", "from", "to"],
              "properties": {
                "recorded_at": {"type": "string", "format": "date-time"},
                "reason": {"type": "string", "minLength": 1},
                "actor": {"$ref": "#/$defs/ownerActor"},
                "from": {"$ref": "#/$defs/objectiveTransition"},
                "to": {"$ref": "#/$defs/objectiveTransition"}
              }
            }
          },
          "objective_id": {
            "minLength": 1,
            "type": "string"
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          },
          "remote_recovery": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "branch": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "commit": {
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string"
                  },
                  "tree": {
                    "pattern": "^[0-9a-f]{40}$",
                    "type": "string"
                  }
                },
                "required": [
                  "branch",
                  "commit",
                  "tree"
                ],
                "type": "object"
              }
            ]
          },
          "status": {
            "enum": [
              "ACTIVE",
              "SAFE_TO_ARCHIVE"
            ]
          },
          "thread_id": {
            "minLength": 1,
            "type": "string"
          },
          "worktree": {
            "minLength": 1,
            "type": "string"
          },
          "write_set": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "worktree",
          "thread_id",
          "objective_id",
          "owner",
          "execution_owner",
          "status",
          "next_action",
          "write_set",
          "remote_recovery"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "machine": {
      "minLength": 1,
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "type": "string"
    },
    "schema": {
      "const": "opl_flow_worktree_ownership_ledger.v1"
    }
  },
  "required": [
    "schema",
    "machine",
    "recorded_at",
    "entries"
  ],
  "$defs": {
    "ownerActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "owner", "execution_owner"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "execution_owner": {"type": "string", "minLength": 1}
      }
    },
    "ownerTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "objective_id", "owner", "execution_owner", "next_action"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1},
        "objective_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "execution_owner": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "objectiveTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "next_action"],
      "properties": {
        "objective_id": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1}
      }
    }
  },
  "title": "OPL Flow worktree ownership ledger",
  "type": "object"
}
