{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaofeng21cn/opl-flow/contracts/workflow-policy.schema.json",
  "title": "OPL Flow workflow policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "workflow_generation",
    "provides",
    "requires",
    "experience_baseline",
    "compatible_optional",
    "capability_bundles",
    "conflicts",
    "retires",
    "codex_model_policy",
    "migration_policy",
    "historical_fingerprints"
  ],
  "properties": {
    "$schema": { "const": "./workflow-policy.schema.json" },
    "schema": { "const": "opl_flow_workflow_policy.v4" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "kind"],
      "properties": {
        "id": { "const": "opl-flow" },
        "version": { "type": "string", "minLength": 1 },
        "owner": { "const": "opl-flow" },
        "kind": { "const": "workflow_profile" }
      }
    },
    "workflow_generation": { "type": "string", "minLength": 1 },
    "provides": { "$ref": "#/$defs/providedCapabilities" },
    "requires": { "$ref": "#/$defs/dependencies" },
    "experience_baseline": { "$ref": "#/$defs/dependencies" },
    "compatible_optional": { "$ref": "#/$defs/dependencies" },
    "capability_bundles": { "$ref": "#/$defs/capabilityBundles" },
    "conflicts": { "$ref": "#/$defs/migrations" },
    "retires": { "$ref": "#/$defs/migrations" },
    "codex_model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "mode_default", "configured_default", "override_precedence", "catalog_policy"],
      "properties": {
        "authority": { "const": "opl-flow" },
        "mode_default": { "const": "auto" },
        "configured_default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoning_effort"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "reasoning_effort": { "type": "string", "minLength": 1 }
          }
        },
        "override_precedence": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "catalog_policy": { "type": "object" }
      }
    },
    "migration_policy": { "type": "object" },
    "historical_fingerprints": { "type": "object" }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "online_install_default",
        "activation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["base", "codex_skill", "codex_plugin", "mcp_server", "cli", "runtime_capability"] },
        "owner": { "type": "string", "minLength": 1 },
        "bundle_id": { "type": "string", "minLength": 1 },
        "version_requirement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "install_source": { "type": "string", "minLength": 1 },
        "lifecycle_owner": { "type": "string", "minLength": 1 },
        "online_install_default": { "type": "boolean" },
        "offline_bundle": { "enum": ["none", "full"] },
        "activation": { "enum": ["always", "task_routed", "explicit"] },
        "readiness_adapter": {
          "enum": [
            "codex_skill_payload",
            "binary_version",
            "agent_reach_doctor",
            "runtime_observation"
          ]
        },
        "conflict_policy": { "enum": ["managed_reconcile", "preserve_user_surface", "fail_closed_on_collision"] },
        "credential_policy": { "enum": ["none", "user_or_provider_owned_not_bundled"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "codex_skill" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["source", "source_path"],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
              },
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              }
            }
          }
        }
      ]
    },
    "providedCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/capability" },
          {
            "properties": {
              "kind": { "enum": ["codex_skill", "codex_plugin"] },
              "online_install_default": { "const": true }
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "capabilityBundles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capabilityBundle" }
    },
    "capabilityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "relationship",
        "member_refs",
        "online_materialization",
        "full_distribution",
        "readiness"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "relationship": { "enum": ["experience_baseline", "compatible_optional"] },
        "member_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(base|codex_skill|codex_plugin|mcp_server|cli|runtime_capability):[^:]+$"
          }
        },
        "online_materialization": { "enum": ["members_marked_default", "observe_only"] },
        "full_distribution": { "enum": ["members_marked_full", "none"] },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aggregation", "absence_effect", "repair_policy"],
          "properties": {
            "aggregation": { "enum": ["all_members", "observe_members"] },
            "absence_effect": { "enum": ["degraded_non_blocking", "optional_absent"] },
            "repair_policy": { "enum": ["framework_or_owner_adapter", "none"] }
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "discovery_ids", "config_markers", "service_ids", "auto_retire_on_optimize", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "discovery_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "config_markers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "service_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "skill_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["discovery_root", "lock_file", "source", "source_url", "skill_paths"],
            "properties": {
              "discovery_root": { "const": "agent_skills" },
              "lock_file": { "const": "agent_skill_lock" },
              "source": { "type": "string", "minLength": 1 },
              "source_url": {
                "type": "string",
                "pattern": "^https://github\\.com/[^/]+/[^/]+\\.git$"
              },
              "skill_paths": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+/SKILL\\.md$"
                }
              }
            }
          },
          "auto_retire_on_optimize": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
