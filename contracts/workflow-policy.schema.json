{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gaofeng21cn/opl-flow/contracts/workflow-policy.schema.json",
  "title": "OPL Flow workflow policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "workflow_generation",
    "task_boundary_policy",
    "external_artifact_language_policy",
    "provides",
    "requires",
    "experience_baseline",
    "compatible_optional",
    "capability_bundles",
    "conflicts",
    "retires",
    "ledger_supervisor_policy",
    "task_owner_migration_policy",
    "codex_app_owner_migration_policy",
    "codex_model_policy",
    "migration_policy",
    "historical_fingerprints"
  ],
  "properties": {
    "$schema": { "const": "./workflow-policy.schema.json" },
    "schema": { "const": "opl_flow_workflow_policy.v4" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "kind"],
      "properties": {
        "id": { "const": "opl-flow" },
        "version": { "type": "string", "minLength": 1 },
        "owner": { "const": "opl-flow" },
        "kind": { "const": "workflow_profile" }
      }
    },
    "workflow_generation": { "type": "string", "minLength": 1 },
    "task_boundary_policy": { "$ref": "#/$defs/taskBoundaryPolicy" },
    "external_artifact_language_policy": { "$ref": "#/$defs/externalArtifactLanguagePolicy" },
    "provides": { "$ref": "#/$defs/providedCapabilities" },
    "requires": { "$ref": "#/$defs/dependencies" },
    "experience_baseline": { "$ref": "#/$defs/dependencies" },
    "compatible_optional": { "$ref": "#/$defs/dependencies" },
    "capability_bundles": { "$ref": "#/$defs/capabilityBundles" },
    "conflicts": { "$ref": "#/$defs/migrations" },
    "retires": { "$ref": "#/$defs/migrations" },
    "ledger_supervisor_policy": { "$ref": "#/$defs/ledgerSupervisorPolicy" },
    "task_owner_migration_policy": { "$ref": "#/$defs/taskOwnerMigrationPolicy" },
    "codex_app_owner_migration_policy": { "$ref": "#/$defs/codexAppOwnerMigrationPolicy" },
    "codex_model_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "mode_default", "configured_default", "override_precedence", "catalog_policy"],
      "properties": {
        "authority": { "const": "opl-flow" },
        "mode_default": { "const": "auto" },
        "configured_default": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoning_effort"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "reasoning_effort": { "type": "string", "minLength": 1 }
          }
        },
        "override_precedence": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "catalog_policy": { "type": "object" }
      }
    },
    "migration_policy": { "type": "object" },
    "historical_fingerprints": { "type": "object" }
  },
  "$defs": {
    "externalArtifactLanguagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_order",
        "consistency_scope",
        "source_language_exemptions",
        "pre_write_gate",
        "post_write_gate",
        "third_party_content"
      ],
      "properties": {
        "authority_order": {
          "const": [
            "explicit_user_language_or_authoritative_repository_rule",
            "existing_object_dominant_language",
            "current_user_request_language_for_new_or_full_rewrite"
          ]
        },
        "consistency_scope": {
          "const": [
            "agent_created_or_user_authorized_title",
            "agent_created_or_user_authorized_body",
            "agent_created_or_user_authorized_reply"
          ]
        },
        "source_language_exemptions": {
          "const": [
            "product_name",
            "code_identifier",
            "api_route",
            "environment_variable",
            "verbatim_quote"
          ]
        },
        "pre_write_gate": { "const": "resolve_and_check_artifact_language" },
        "post_write_gate": { "const": "fresh_readback_language_consistency" },
        "third_party_content": { "const": "preserve_without_explicit_authority" }
      }
    },
    "taskBoundaryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "stop_ladder",
        "expansion_rule",
        "unsupported_expansion",
        "task_modes",
        "production_change_handoff",
        "repair_progress_policy"
      ],
      "properties": {
        "authority": { "const": "opl-flow" },
        "stop_ladder": {
          "const": [
            "user_request",
            "necessity",
            "reachable_evidence",
            "acceptance_dependency"
          ]
        },
        "expansion_rule": { "const": "only_stop_ladder_reasons" },
        "unsupported_expansion": { "const": "defer_and_report" },
        "task_modes": {
          "const": [
            {
              "id": "answer",
              "mutation": "read_only",
              "scope": "requested_answer"
            },
            {
              "id": "review",
              "mutation": "read_only",
              "scope": "requested_review_surface"
            },
            {
              "id": "change",
              "mutation": "requested_result_and_necessary_consequences",
              "scope": "requested_change"
            },
            {
              "id": "monitor",
              "mutation": "read_only",
              "scope": "bounded_observation_and_requested_alerts"
            }
          ]
        },
        "production_change_handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "router_skill_id",
            "reference",
            "precondition",
            "relationship"
          ],
          "properties": {
            "router_skill_id": { "const": "software-development" },
            "reference": { "const": "references/delivery/production-change.md" },
            "precondition": { "const": "stop_ladder_supported_reason_and_high_risk_mutation" },
            "relationship": { "const": "stop_ladder_then_reference" }
          }
        },
        "repair_progress_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "known_breakpoint_next_action",
            "proof_role",
            "green_without_breakpoint_movement",
            "post_event_transition",
            "wait_only_active",
            "stale_test_contract"
          ],
          "properties": {
            "known_breakpoint_next_action": {
              "const": "owner_side_repair_or_delivery_bridge"
            },
            "proof_role": { "const": "tests_verify_after_repair" },
            "green_without_breakpoint_movement": { "const": "not_progress" },
            "post_event_transition": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "breakpoint_unchanged",
                "breakpoint_moved",
                "proof_failed",
                "external_blocker"
              ],
              "properties": {
                "breakpoint_unchanged": {
                  "const": ["direct_fix", "delivery_bridge", "stop"]
                },
                "breakpoint_moved": {
                  "const": ["proof", "acceptance", "complete"]
                },
                "proof_failed": {
                  "const": ["direct_fix", "delivery_bridge", "stop"]
                },
                "external_blocker": {
                  "const": ["stop"]
                }
              }
            },
            "wait_only_active": { "const": false },
            "stale_test_contract": {
              "const": "preserve_product_fix_update_test_contract"
            }
          }
        }
      }
    },
    "codexAppOwnerMigrationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "executor_kind",
        "target_visibility",
        "creation_route",
        "ssh_role",
        "headless_cli_policy",
        "source_release_gate",
        "failure_fallback",
        "workspace_scope",
        "full_workspace_required",
        "automation_policy"
      ],
      "properties": {
        "authority": { "const": "codex_app_native_owner_tools" },
        "executor_kind": { "const": "native_codex_app_task" },
        "target_visibility": {
          "const": [
            "connected_host_visible",
            "all_profile_repositories_visible",
            "native_task_visible_in_target_app",
            "task_readback_matches_host_project_and_cwd"
          ]
        },
        "creation_route": {
          "const": [
            "codex_app_create_thread_in_saved_project",
            "codex_app_handoff_thread_when_supported"
          ]
        },
        "ssh_role": { "const": "transport_bootstrap_or_readback_only" },
        "headless_cli_policy": { "const": "never_accept_as_native_owner" },
        "source_release_gate": {
          "const": [
            "target_task_acknowledged",
            "target_task_readable",
            "claim_readback_matches",
            "target_started_or_waiting"
          ]
        },
        "failure_fallback": {
          "const": "local_owner_continues;rollback_before_claim_or_reverse_migration_after_claim"
        },
        "workspace_scope": { "const": "instance_profile_repository_allowlist" },
        "full_workspace_required": { "const": true },
        "automation_policy": { "const": "separate_singleton_cas_cutover" }
      }
    },
    "taskOwnerMigrationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "objective_identity",
        "executor_handle",
        "native_handoff",
        "workspace_authority",
        "workspace_admission",
        "state_sequence",
        "claim_mutations",
        "post_claim_rollback",
        "dolt_unknown_result",
        "automation_cutover"
      ],
      "properties": {
        "authority": { "const": "beads_dolt" },
        "objective_identity": { "const": "bead_id" },
        "executor_handle": { "const": "replaceable_codex_task" },
        "native_handoff": { "const": "optional_non_authoritative" },
        "workspace_authority": { "const": "private_instance_profile" },
        "workspace_admission": {
          "const": [
            "declared_environment_current",
            "fresh_fetch",
            "fresh_github_head",
            "clean_default_branch",
            "no_active_task_worktree",
            "current_instance_control_receipt"
          ]
        },
        "state_sequence": {
          "const": [
            "source_checkpointed",
            "target_preflighted",
            "target_acknowledged",
            "target_verified",
            "completed"
          ]
        },
        "claim_mutations": {
          "const": [
            "opl_owner_claim_generation",
            "execution_owner",
            "execution_thread",
            "execution_node"
          ]
        },
        "post_claim_rollback": { "const": "reverse_migration_only" },
        "dolt_unknown_result": { "const": "read_only_reconcile_no_retry" },
        "automation_cutover": {
          "const": ["old_disabled_readback", "new_active_readback"]
        }
      }
    },
    "ledgerSupervisorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_driven_control_plane", "incremental_fast_path", "linear_assignee_projection", "task_lifecycle_classes", "bounded_executor_policy", "execution_modes", "native_owner_tools", "comment_delivery"],
      "properties": {
        "event_driven_control_plane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dispatch_mode", "global_supervisor", "product_controller", "executor", "fallback", "idle_product_activity"],
          "properties": {
            "dispatch_mode": { "const": "event_driven" },
            "global_supervisor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "scheduled_episode_scope", "product_progress_polling"],
              "properties": {
                "role": { "const": "ledger_macro_reconciliation_and_exception_fallback" },
                "scheduled_episode_scope": { "const": "bounded_change_detection_and_ledger_reconciliation" },
                "product_progress_polling": { "const": false }
              }
            },
            "product_controller": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "callback_handling", "resident_polling"],
              "properties": {
                "role": { "const": "objective_graph_acceptance_and_successor_dispatch" },
                "callback_handling": { "const": "same_episode_accept_repair_or_dispatch" },
                "resident_polling": { "const": false }
              }
            },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "callback_target", "callback_events", "callback_is_completion_evidence"],
              "properties": {
                "role": { "const": "bounded_slice_execution" },
                "callback_target": { "const": "product_controller" },
                "callback_events": { "const": ["checkpoint", "terminal", "real_blocker"] },
                "callback_is_completion_evidence": { "const": false }
              }
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "required": ["owner", "triggers", "routine_progress_polling"],
              "properties": {
                "owner": { "const": "global_supervisor" },
                "triggers": { "const": ["executor_lost", "callback_missing", "cross_objective_owner_or_write_set_conflict"] },
                "routine_progress_polling": { "const": false }
              }
            },
            "idle_product_activity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["product_reads", "successor_dispatches", "semantic_writes"],
              "properties": {
                "product_reads": { "const": 0 },
                "successor_dispatches": { "const": 0 },
                "semantic_writes": { "const": 0 }
              }
            }
          }
        },
        "incremental_fast_path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase_order", "state_owner", "thread_detection", "linear_detection", "external_review", "full_audit", "observability_counters", "no_change_budget"],
          "properties": {
            "phase_order": { "const": ["change_detection", "selective_expansion"] },
            "state_owner": { "const": "private_supervisor_memory_cursor_location" },
            "thread_detection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inventory_source", "observation_fields", "excluded_observation_fields", "progress_signal_source", "wait_threads_policy", "wait_timeout_ms", "wait_batch_size", "exact_read_triggers", "registered_task_user_message_policy"],
              "properties": {
                "inventory_source": { "const": "list_threads" },
                "observation_fields": { "const": ["updatedAt", "status", "hasUnreadTurn"] },
                "excluded_observation_fields": { "const": ["title"] },
                "progress_signal_source": { "const": "executor_callback_to_product_controller" },
                "wait_threads_policy": { "const": "fallback_only_after_executor_loss_missing_callback_or_cross_objective_conflict" },
                "wait_timeout_ms": { "const": 0 },
                "wait_batch_size": { "const": 8 },
                "exact_read_triggers": {
                  "const": [
                    "new_thread",
                    "summary_changed",
                    "wait_cursor_changed",
                    "has_unread_turn",
                    "review_due",
                    "ambiguous_owner_state",
                    "new_authorized_user_message_on_registered_task"
                  ]
                },
                "registered_task_user_message_policy": {
                  "const": "inspect_new_user_messages_in_changed_registered_objective_threads;authorized_user_message_overrides_review_backoff_and_requires_same_episode_reconcile_reply_or_status_projection"
                }
              }
            },
            "linear_detection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["issue_delta_source", "comment_read_scope", "newest_comment_order_assumption"],
              "properties": {
                "issue_delta_source": { "const": "list_issues_updated_after_project_waterline" },
                "comment_read_scope": { "const": "changed_issues_only" },
                "newest_comment_order_assumption": { "const": "forbidden" }
              }
            },
            "external_review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["backoff_field", "hourly_polling", "early_recheck_triggers"],
              "properties": {
                "backoff_field": { "const": "next_review_at" },
                "hourly_polling": { "const": false },
                "early_recheck_triggers": {
                  "const": [
                    "user_change",
                    "owner_change",
                    "issue_change",
                    "schema_or_policy_change",
                    "relevant_repository_change"
                  ]
                }
              }
            },
            "full_audit": {
              "type": "object",
              "additionalProperties": false,
              "required": ["periodic_schedule", "minimum_interval_hours", "triggers"],
              "properties": {
                "periodic_schedule": { "const": false },
                "minimum_interval_hours": { "const": 24 },
                "triggers": {
                  "const": [
                    "missing_or_ambiguous_cursor",
                    "schema_or_policy_change",
                    "timeout_unknown",
                    "explicit_user_request"
                  ]
                }
              }
            },
            "observability_counters": {
              "const": [
                "threads_listed",
                "thread_summaries_changed",
                "wait_targets",
                "wait_cursors_changed",
                "threads_read",
                "linear_projects_probed",
                "linear_issues_changed",
                "linear_comment_pages",
                "authority_checks",
                "semantic_writes",
                "retries",
                "elapsed_seconds",
                "full_audit_reason"
              ]
            },
            "no_change_budget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["list_threads_calls", "wait_threads_calls", "linear_issue_delta_calls_per_project", "read_thread_calls", "linear_comment_calls", "authority_checks", "semantic_writes", "expected_runtime_seconds"],
              "properties": {
                "list_threads_calls": { "const": 1 },
                "wait_threads_calls": { "const": 0 },
                "linear_issue_delta_calls_per_project": { "const": 1 },
                "read_thread_calls": { "const": 0 },
                "linear_comment_calls": { "const": 0 },
                "authority_checks": { "const": 0 },
                "semantic_writes": { "const": 0 },
                "expected_runtime_seconds": { "const": 60 }
              }
            }
          }
        },
        "linear_assignee_projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "single_account_required", "multiple_accounts_policy", "scope", "repair_selection", "full_repair_triggers", "write_batch_size", "readback", "execution_truth_owner"],
          "properties": {
            "mode": { "const": "single_authorized_human" },
            "source": { "const": "heartbeat_authorized_human_accounts" },
            "single_account_required": { "const": true },
            "multiple_accounts_policy": { "const": "fail_closed_require_project_mapping" },
            "scope": { "const": "all_registered_project_issues" },
            "repair_selection": { "const": "changed_or_drifted_issues_only" },
            "full_repair_triggers": {
              "const": [
                "explicit_user_request",
                "policy_change",
                "missing_assignment_waterline"
              ]
            },
            "write_batch_size": { "const": 10 },
            "readback": { "const": "exact_project_issue_count_and_zero_mismatches" },
            "execution_truth_owner": { "const": "beads_dolt_not_linear_assignee" }
          }
        },
        "task_lifecycle_classes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["managed_objective", "interactive_longline", "ephemeral_operation"],
          "properties": {
            "managed_objective": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enrollment", "lifecycle_authority", "terminal_inference", "title_projection"],
              "properties": {
                "enrollment": { "const": "default_for_finite_development_and_delivery" },
                "lifecycle_authority": { "const": "beads_and_owner_readback" },
                "terminal_inference": { "const": "authoritative_outcome_and_remaining_empty" },
                "title_projection": { "const": "execution_state" }
              }
            },
            "interactive_longline": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enrollment", "lifecycle_authority", "terminal_inference", "title_projection"],
              "properties": {
                "enrollment": { "const": "explicit_or_existing_registered_long_lived_interactive_task" },
                "lifecycle_authority": { "const": "user_codex_task_archive" },
                "terminal_inference": { "const": "forbidden" },
                "title_projection": { "const": "fresh_thread_activity" }
              }
            },
            "ephemeral_operation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enrollment", "lifecycle_authority", "terminal_inference", "title_projection"],
              "properties": {
                "enrollment": { "const": "excluded_by_default_or_explicit_record_only" },
                "lifecycle_authority": { "const": "user_codex_task_archive" },
                "terminal_inference": { "const": "forbidden" },
                "title_projection": { "const": "fresh_thread_activity" }
              }
            }
          }
        },
        "bounded_executor_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "live_binding",
            "history_binding",
            "archived_history_policy",
            "trigger_action",
            "unbind_after_authoritative_readback"
          ],
          "properties": {
            "live_binding": { "const": "execution_thread" },
            "history_binding": { "const": "last_execution_thread" },
            "archived_history_policy": { "const": "provenance_only_never_resume" },
            "trigger_action": { "const": "resume_unarchived_or_create_new" },
            "unbind_after_authoritative_readback": { "const": true }
          }
        },
        "execution_modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backlog", "on_demand"],
          "properties": {
            "backlog": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beads_status", "linear_status", "linear_status_type", "execution_thread", "dispatch", "eligible_classes"],
              "properties": {
                "beads_status": { "const": "deferred" },
                "linear_status": { "const": "Backlog" },
                "linear_status_type": { "const": "backlog" },
                "execution_thread": { "type": ["null"] },
                "dispatch": { "const": "planned_capacity_or_dependency_release" },
                "eligible_classes": {
                  "const": ["managed_objective"]
                }
              }
            },
            "on_demand": {
              "type": "object",
              "additionalProperties": false,
              "required": ["beads_status", "linear_status", "linear_status_type", "execution_thread", "dispatch", "terminal_inference", "eligible_classes", "purpose"],
              "properties": {
                "beads_status": { "const": "pinned" },
                "linear_status": { "const": "On Demand" },
                "linear_status_type": { "const": "backlog" },
                "execution_thread": { "type": ["null"] },
                "dispatch": { "const": "user_intent_or_explicit_trigger_only" },
                "terminal_inference": { "const": "forbidden" },
                "eligible_classes": {
                  "const": ["interactive_longline"]
                },
                "purpose": { "const": "long_horizon_irregular_manual_followup" }
              }
            }
          }
        },
        "native_owner_tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preflight_required", "list_threads_max_limit", "failure_classes"],
          "properties": {
            "preflight_required": { "const": true },
            "list_threads_max_limit": { "type": "integer", "minimum": 1, "maximum": 50 },
            "failure_classes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["invalid_arguments", "permission_denied", "timeout_unknown", "unavailable"],
              "properties": {
                "invalid_arguments": { "const": "caller_schema_error" },
                "permission_denied": { "const": "authorization_required" },
                "timeout_unknown": { "const": "destination_reconciliation_required" },
                "unavailable": { "const": "owner_tool_absent_or_unreachable" }
              }
            }
          }
        },
        "comment_delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idempotency_key",
            "state_sequence",
            "delivery_confirmation_sources",
            "timeout_reconciliation",
            "cursor_advance_gate",
            "automated_reply"
          ],
          "properties": {
            "idempotency_key": { "const": "linear_comment_id" },
            "state_sequence": {
              "const": [
                "comment_observed",
                "destination_delivery_confirmed",
                "owner_answer_read",
                "linear_reply_posted",
                "linear_reply_read_back",
                "cursor_advanced"
              ]
            },
            "delivery_confirmation_sources": {
              "const": [
                "send_message_to_thread_success",
                "destination_read_thread_reconciliation"
              ]
            },
            "timeout_reconciliation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "readback", "bounded_retry_limit", "retry_condition"],
              "properties": {
                "status": { "const": "timeout_unknown" },
                "readback": { "const": "destination_read_thread" },
                "bounded_retry_limit": { "const": 1 },
                "retry_condition": { "const": "confirmed_absent_after_destination_readback" }
              }
            },
            "cursor_advance_gate": { "const": "linear_reply_read_back" },
            "automated_reply": {
              "type": "object",
              "additionalProperties": false,
              "required": ["first_line", "required_provenance", "non_user_detection"],
              "properties": {
                "first_line": { "const": "【OPL Flow · Codex 自动回复】" },
                "required_provenance": { "const": ["source_codex_task", "answer_provenance"] },
                "non_user_detection": { "const": "marker_not_linear_author_identity" }
              }
            }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "online_install_default",
        "activation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["base", "codex_skill", "codex_plugin", "mcp_server", "cli", "runtime_capability"] },
        "owner": { "type": "string", "minLength": 1 },
        "bundle_id": { "type": "string", "minLength": 1 },
        "version_requirement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "source_path": { "type": "string", "minLength": 1 },
        "install_source": { "type": "string", "minLength": 1 },
        "lifecycle_owner": { "type": "string", "minLength": 1 },
        "online_install_default": { "type": "boolean" },
        "offline_bundle": { "enum": ["none", "full"] },
        "activation": { "enum": ["always", "task_routed", "explicit"] },
        "readiness_adapter": {
          "enum": [
            "codex_skill_payload",
            "binary_version",
            "agent_reach_doctor",
            "runtime_observation"
          ]
        },
        "conflict_policy": { "enum": ["managed_reconcile", "preserve_user_surface", "fail_closed_on_collision"] },
        "credential_policy": { "enum": ["none", "user_or_provider_owned_not_bundled"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "codex_skill" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["source", "source_path"],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
              },
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
              }
            }
          }
        }
      ]
    },
    "providedCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/capability" },
          {
            "properties": {
              "kind": { "enum": ["codex_skill", "codex_plugin"] },
              "online_install_default": { "const": true }
            }
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "capabilityBundles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capabilityBundle" }
    },
    "capabilityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "relationship",
        "member_refs",
        "online_materialization",
        "full_distribution",
        "readiness"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "relationship": { "enum": ["experience_baseline", "compatible_optional"] },
        "member_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(base|codex_skill|codex_plugin|mcp_server|cli|runtime_capability):[^:]+$"
          }
        },
        "online_materialization": { "enum": ["members_marked_default", "observe_only"] },
        "full_distribution": { "enum": ["members_marked_full", "none"] },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aggregation", "absence_effect", "repair_policy"],
          "properties": {
            "aggregation": { "enum": ["all_members", "observe_members"] },
            "absence_effect": { "enum": ["degraded_non_blocking", "optional_absent"] },
            "repair_policy": { "enum": ["framework_or_owner_adapter", "none"] }
          }
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "discovery_ids", "config_markers", "service_ids", "auto_retire_on_optimize", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "discovery_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "surface_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["plugin", "skill", "service", "config_table", "prompt_or_agent"] }
          },
          "config_markers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "service_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "auto_retire_on_optimize": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
